# Para ejecutar estas requests instalar la extensión "REST Client" de VS Code

# Activar el cookie jar en
# settings.json de VS Code:  "rest-client.cookieJar": true
# Antes de correr el archivo: npm run seed, y levantar el server con npm run dev.
# Ejecutá las requests EN ORDEN: primero los casos anónimos (sin sesión aún),
# después el login admin, luego el resto.

@host = http://localhost:3001


# ===================================================================
# SEGURIDAD — casos anónimos (ejecutar ANTES de cualquier login)
# ===================================================================

### Salud del servicio: sigue ABIERTA para health-check de Render (espera 200)
GET {{host}}/api/health

### API sin sesión: GET debe responder 401 JSON (success: false)
GET {{host}}/api/lotes

### API sin sesión: POST también 401 (el middleware corta antes que la validación)
POST {{host}}/api/productores
Content-Type: application/json

{
  "nombre": "Intento anónimo"
}


# ===================================================================
# SEGURIDAD — login y roles
# ===================================================================

### Login correcto como admin (espera 302 -> /; la cookie entra al cookie jar)
POST {{host}}/login
Content-Type: application/x-www-form-urlencoded

usuario=admin&password=admin123

### Login con contraseña incorrecta (espera 302 -> /login?error=1; no crea sesión)
POST {{host}}/login
Content-Type: application/x-www-form-urlencoded

usuario=admin&password=incorrecta

### GET autenticado con la sesión de admin (espera 200)
GET {{host}}/api/lotes


# ===================================================================
# PRODUCTORES
# ===================================================================

### Productores: listar todos
GET {{host}}/api/productores

### Productores: obtener uno por id
GET {{host}}/api/productores/857bd7d93681780a1dcda895

### Productores: lotes del productor
GET {{host}}/api/productores/857bd7d93681780a1dcda895/lotes

### Productores: crear uno nuevo (admin: espera 201)
POST {{host}}/api/productores
Content-Type: application/json

{
  "nombre": "Productor de Prueba",
  "cuit": "20-12345678-6",
  "email": "prueba3@agrotec.com",
  "telefono": "1122334455",
  "localidad": "Pergamino"
}

### Productores: actualizar (usar un id creado arriba o ad504b14f116c40c96d33b72)
PUT {{host}}/api/productores/ad504b14f116c40c96d33b72
Content-Type: application/json

{
  "nombre": "Productor Actualizado",
  "cuit": "20-87654321-9",
  "email": "actualizado@agrotec.com",
  "telefono": "1155667788",
  "localidad": "Junín"
}

### Productores: eliminar
DELETE {{host}}/api/productores/ad504b14f116c40c96d33b72


# ===================================================================
# LOTES
# ===================================================================

### Lotes: listar todos
GET {{host}}/api/lotes

### Lotes: filtrar por nivel de alerta (Normal | Atención | Crítico)
GET {{host}}/api/lotes?alerta=Crítico

### Lotes: filtrar por productor
GET {{host}}/api/lotes?productorId=857bd7d93681780a1dcda895

### Lotes: obtener uno por id
GET {{host}}/api/lotes/e5b274ac98f77b349f0a1f3d

### Lotes: historial de observaciones del lote
GET {{host}}/api/lotes/e5b274ac98f77b349f0a1f3d/observaciones

### Lotes: crear uno nuevo (admin: espera 201)
POST {{host}}/api/lotes
Content-Type: application/json

{
  "nombre": "Lote de Prueba",
  "hectareas": 25,
  "productorId": "857bd7d93681780a1dcda895",
  "ubicacion": "Ruta 9 km 5"
}

### Lotes: actualizar
PUT {{host}}/api/lotes/eada5362fbe4c421d83c75c8
Content-Type: application/json

{
  "nombre": "Lote Actualizado",
  "hectareas": 40,
  "productorId": "f34b21e622745c1fb1683d38",
  "ubicacion": "Camino Real km 3"
}

### Lotes: eliminar
DELETE {{host}}/api/lotes/eada5362fbe4c421d83c75c8


# ===================================================================
# OBSERVACIONES
# ===================================================================

### Observaciones: listar todas
GET {{host}}/api/observaciones

### Observaciones: filtrar por nivel de alerta
GET {{host}}/api/observaciones?alerta=Atención

### Observaciones: filtrar por lote
GET {{host}}/api/observaciones?loteId=e5b274ac98f77b349f0a1f3d

### Observaciones: filtrar por técnico
GET {{host}}/api/observaciones?tecnicoId=88874107c49eee3dc1f59416

### Observaciones: obtener una por id
GET {{host}}/api/observaciones/708d318c2b974143b4b14add

### Observaciones: crear una nueva
POST {{host}}/api/observaciones
Content-Type: application/json

{
  "loteId": "e5b274ac98f77b349f0a1f3d",
  "tecnicoId": "88874107c49eee3dc1f59416",
  "fecha": "2026-09-01",
  "tipoCultivoId": "2a2545d8c5a491a4b0955563",
  "estadoCultivo": "Bueno",
