doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title ? `${title} | AgroTec` : "AgroTec"
    link(rel="stylesheet" href="/css/estilos.css")
  body
    header.topbar
      a.marca(href="/") AgroTec
      nav
        if currentUser
          a(href="/") Inicio
          a(href="/lotes") Lotes
          a(href="/observaciones") Observaciones
        if currentUser && currentUser.role === 'admin'
          a(href="/observaciones/nueva") Nueva observación
          a(href="/api/health") API
        if currentUser
          span.sesion= `${currentUser.nombre} · ${currentUser.role}`
          form.form-logout(action="/logout" method="POST")
            button.btn.btn-sm(type="submit") Salir
        else
          a(href="/login") Iniciar sesión
    main.contenedor
      block contenido
    footer
      p Segunda entrega — Monitoreo de lotes · MongoDB y Login · MVC
